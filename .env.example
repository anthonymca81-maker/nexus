# Nexus Tech Store - Database Configuration
# Copy this file to .env and fill in your values.
# .env should never be committed to version control.

# Server name as shown in SSMS "Connect to Server"
# Common values: localhost\SQLEXPRESS | .\SQLEXPRESS | (localdb)\MSSQLLocalDB | localhost
NEXUS_DB_SERVER=localhost\SQLEXPRESS

# Database name (default: nexus_tech_store)
NEXUS_DB_NAME=nexus_tech_store

# Leave NEXUS_DB_USER empty to use Windows Authentication (recommended).
# Fill both in only if you use a SQL Server login (e.g. sa).
NEXUS_DB_USER=
NEXUS_DB_PASSWORD=

# ODBC driver override — leave empty to auto-select the newest installed driver.
# Example: ODBC Driver 18 for SQL Server
NEXUS_DB_DRIVER=
